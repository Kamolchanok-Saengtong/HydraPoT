# ═══════════════════════════════════════════════════════════════════════════════
# HydraPoT — environment template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#
#     cp .env.example .env
#     $EDITOR .env
#
# .env is gitignored. THIS file is committed, so it must never contain a real
# key -- placeholders only.
#
# Loaded automatically by config_loader.py at import, so anything that imports
# HydraPoT config sees these. A REAL environment variable always wins over a
# line here: `export PSU_API_KEY=...` in your shell, a systemd unit, or a
# container secret overrides the file. That ordering matters -- otherwise you
# rotate a key in production and a stale checked-out file quietly undoes it.
#
# Format: KEY=VALUE, one per line. `#` comments, blank lines ignored, quotes
# optional. `export KEY=VALUE` also works, so this file can be `source`d by a
# shell if you prefer.
# ═══════════════════════════════════════════════════════════════════════════════

# ── LLM ───────────────────────────────────────────────────────────────────────
PSU_API_KEY=sk-replace-me
# OpenAI-compatible endpoint. Overrides agents.cloud.base_url in config.yaml.
# Leave unset to use whatever config.yaml says.
HYDRAPOT_AI_BASE_URL=https://ai.psu.blue/v1

# Model id, overrides agents.cloud.model.
HYDRAPOT_AI_MODEL=openai/gpt-5.6-luna

# ── Alert notification channels (all optional) ────────────────────────────────
# Only needed if you enable a channel in threat_intel/alerts.yml AND the
# `channels` sink in threat_intel/rules/alert_sinks.yml. Both ship OFF, so
# nothing is sent anywhere until you deliberately turn them on.
# ALERT_WEBHOOK_URL=https://example.com/your-webhook
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/YYY
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_CHAT_ID=123456789
# SMTP_PASSWORD=your-smtp-password
