# ═══════════════════════════════════════════════════════════════════════════════
# HydraPoT — environment template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#
#     cp .env.example .env
#     $EDITOR .env
#
# .env is gitignored. THIS file is committed, so it must never contain a real
# key -- placeholders only.
#
# Loaded automatically by config_loader.py at import, so anything that imports
# HydraPoT config sees these. A REAL environment variable always wins over a
# line here: `export CLOUD_AGENT_API_KEY=...` in your shell, a systemd unit, or a
# container secret overrides the file. That ordering matters -- otherwise you
# rotate a key in production and a stale checked-out file quietly undoes it.
#
# Format: KEY=VALUE, one per line. `#` comments, blank lines ignored, quotes
# optional. `export KEY=VALUE` also works, so this file can be `source`d by a
# shell if you prefer.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Cloud agent: answers the ATTACKER ─────────────────────────────────────────
# Without this set, `hp --run` stops and says so -- the shipped config has the
# cloud agent enabled. Either set a key, or set agents.cloud.enabled: false in
# config.yaml to run on Cowrie and the local model alone.
CLOUD_AGENT_API_KEY=sk-replace-me

# OpenAI-compatible endpoint and model for the cloud agent. Both override
# agents.cloud.* in config.yaml. Leave unset to use whatever config.yaml says.
# CLOUD_AGENT_BASE_URL=https://api.example.com/v1
# CLOUD_AGENT_MODEL=your-model-id

# ── AI Security Analyst: answers YOU ──────────────────────────────────────────
# A SEPARATE model from the cloud agent above. It reads HydraPoT's findings
# through the read-only REST API and explains them to the operator; it never
# impersonates a shell. Usually a stronger model, and often the one you want
# enabled while the cloud agent is off (or the reverse).
#
# Setting the key is what ENABLES it -- there is no separate on/off flag.
# AI_API_KEY=sk-replace-me

# Endpoint and model for the analyst. These override ai_assistant.* and do NOT
# touch the cloud agent -- that is what CLOUD_AGENT_* above is for.
# AI_BASE_URL=https://api.example.com/v1
# AI_MODEL=your-model-id

# ── Local model served over HTTP (optional) ───────────────────────────────────
# Only when agents.on_device.mode is "remote" -- the default "local" loads the
# GGUF in-process and needs no key.
# ONDEVICE_KEY=

# ── REST API ──────────────────────────────────────────────────────────────────
# Shared secret for /api/v1. Leave it UNSET and the API is open, which is what
# a localhost dashboard wants. Set it and every v1 route requires the header:
#
#     curl -H 'X-API-Key: <key>' http://127.0.0.1:8050/api/v1/health
#
# Generate one with:  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# HYDRAPOT_API_KEY=

# ── Alert notification channels (all optional) ────────────────────────────────
# Only needed if you enable a channel in threat_intel/alerts.yml AND the
# `channels` sink in threat_intel/rules/alert_sinks.yml. Both ship OFF, so
# nothing is sent anywhere until you deliberately turn them on.
#
# These names are not fixed in code: alerts.yml names the variable to read for
# each channel (webhook_env, bot_token_env, ...). Change a name there and
# change it here to match.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXX/YYY
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_CHAT_ID=123456789
# ALERT_WEBHOOK_URL=https://example.com/your-webhook
# ALERT_EMAIL_USER=alerts@example.com
# ALERT_EMAIL_PASS=your-smtp-password
