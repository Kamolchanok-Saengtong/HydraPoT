# GENERATED by build_partB_benchmark.render_dockerfile() — DO NOT EDIT.
# Every value is derived from config.yaml so the reference box cannot drift
# from the honeypot it is the reference for. Edit config.yaml instead.
#
# Known, deliberately-unaddressed gap: the kernel. Containers share the host
# kernel, while config declares 5.15.0-139-generic — matching it would need
# fragile uname() spoofing, so ground truth reports the host's.
FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    net-tools iproute2 iputils-ping traceroute iputils-arping dnsutils cron openssh-client gnupg curl wget openssl strace ltrace busybox-static pciutils usbutils rpcbind acl libcap2-bin kmod sysstat lshw finger nano vim-tiny less bzip2 xz-utils sudo perl gcc g++ make git python3 ruby htop screen nmap vim \
    && rm -rf /var/lib/apt/lists/*

# Best effort: a renamed or dropped package must not fail the build.
RUN apt-get update -qq && ( apt-get install -y --no-install-recommends \
    bsdmainutils vim-common libglib2.0-bin pulseaudio-utils cups-client \
    || true ) && rm -rf /var/lib/apt/lists/*

# Accounts from system_state.users. Guarded by `id -u`: the system ones
# already exist via base-passwd, and useradd would fail the build.
RUN id -u daemon >/dev/null 2>&1 || useradd -u 1 -d /usr/sbin -s /usr/sbin/nologin daemon || { echo "NOTE: uid 1 taken, creating daemon without it"; useradd -d /usr/sbin -s /usr/sbin/nologin daemon; }
RUN id -u bin >/dev/null 2>&1 || useradd -u 2 -d /bin -s /usr/sbin/nologin bin || { echo "NOTE: uid 2 taken, creating bin without it"; useradd -d /bin -s /usr/sbin/nologin bin; }
RUN id -u www-data >/dev/null 2>&1 || useradd -u 33 -d /var/www -s /usr/sbin/nologin www-data || { echo "NOTE: uid 33 taken, creating www-data without it"; useradd -d /var/www -s /usr/sbin/nologin www-data; }
RUN id -u sshd >/dev/null 2>&1 || useradd -u 126 -d /run/sshd -s /usr/sbin/nologin sshd || { echo "NOTE: uid 126 taken, creating sshd without it"; useradd -d /run/sshd -s /usr/sbin/nologin sshd; }
RUN id -u cocadmin >/dev/null 2>&1 || useradd -u 1001 -d /home/cocadmin -s /bin/bash -c "COC Admin" -m cocadmin || { echo "NOTE: uid 1001 taken, creating cocadmin without it"; useradd -d /home/cocadmin -s /bin/bash -c "COC Admin" -m cocadmin; }
RUN id -u nobody >/dev/null 2>&1 || useradd -u 65534 -d /nonexistent -s /usr/sbin/nologin nobody || { echo "NOTE: uid 65534 taken, creating nobody without it"; useradd -d /nonexistent -s /usr/sbin/nologin nobody; }

# Files from system_state.starting_files — declared perms and size.
# Content was never specified, only perms/size, so filler is padded
# to the declared length.
RUN mkdir -p /var/log && chmod 755 /var/log
RUN mkdir -p /root && head -c 3788 /dev/zero | tr '\0' '#' > /root/.bashrc && chmod 644 /root/.bashrc
RUN mkdir -p /root && head -c 161 /dev/zero | tr '\0' '#' > /root/.profile && chmod 644 /root/.profile
RUN mkdir -p /root && printf '' > /root/.bash_history && chmod 600 /root/.bash_history

WORKDIR /root

CMD ["sleep", "infinity"]
