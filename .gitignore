# ── Evaluation data & results (large, machine-specific, not shipped) ──
# dataset/ is ~1.3 GB of eval datasets
dataset/
eval_cowrie_results.json

# One file per session PER ARM -- 2151 sessions x 4 arms = 8604 files, 176MB,
# which was 99% of every `git status`. It is the command handler's own session
# store (run_partC.py passes store="json"), not a result and not a resume
# point: the real per-command records go to results/partC/<run>/<arm>.jsonl,
# which is what the scorers read. guardrail/DES.py sends the same artifact to
# a tempdir for the same reason.
experiment_data/*/sessions/

# Regenerated by PartC/plot/* and PartC/score/* on every run, so the figures
# and metric dumps show up as modified whenever a plot script is re-run even
# when nothing changed. Produced from results/partC/<run>/<arm>.jsonl, which
# is the data that actually matters. Re-create with score_all_metrics.py then
# plot_metrics_separate.py.
experiment_data/results/partC/semantic_analysis/

.claude/
# MITRE ATT&CK STIX bundle (46MB, regenerate: see threat_intel/mitre_mapper.py)
threat_intel/enterprise-attack.json

threat_intel/.art_cache/
/threat_intel/tests

# generated by cowrie_fs.py — rebuild with `python plugins/cowrie_fs.py`
plugins/cowrie/fs.pickle

