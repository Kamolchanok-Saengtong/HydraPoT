# ml platform -- do not commit
[default]
aws_access_key_id = @AWS_KEY_ID@
aws_secret_access_key = @AWS_SECRET@
region = us-east-1
output = json

[checkpoints]
aws_access_key_id = @AWS_KEY_ID@
aws_secret_access_key = @AWS_SECRET@
region = us-west-2
role_arn = arn:aws:iam::412090361895:role/nexa-ml-checkpoint-writer

# object store for training data and checkpoints
s3_bucket = nexa-ml-checkpoints
s3_prefix = llama3-70b/
