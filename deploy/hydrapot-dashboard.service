# HydraPoT dashboard — systemd unit.
#
# GENERATED by tools/install_service.py from the template alongside it.
# Paths below are baked in for one checkout, so re-run that script after
# moving or reinstalling the project rather than editing this by hand.
#
# Why supervision: without it a crashed sensor stays down until somebody
# notices, and a honeypot that is quiet because it died looks exactly
# like one that is quiet because nobody attacked it.

[Unit]
# StartLimit* live in [Unit], not [Service] — systemd 229 moved them and
# silently ignores them in the wrong section, which disables the restart
# rate limit without any error unless you read the journal.
StartLimitIntervalSec=300
StartLimitBurst=10
Description=HydraPoT dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=creamy
Group=creamy
WorkingDirectory=/mnt/data-partition/honeypot
# --foreground: systemd supervises the process itself, so the CLI must not
# fork and detach the way `hp dashboard` does interactively.
ExecStart=/mnt/data-partition/honeypot/honeypot_new/bin/hp dashboard --foreground --host 127.0.0.1 --port 8050

Restart=always
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/mnt/data-partition/honeypot/data
RestrictSUIDSGID=true

# Python buffers stdout when it is not a TTY, so under systemd every
# log line sat in a 8KB buffer instead of reaching the journal. On a
# quiet sensor that means you see nothing for hours, and anything not
# yet flushed is lost if the process is killed.
Environment=PYTHONUNBUFFERED=1

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hydrapot-dashboard

[Install]
WantedBy=multi-user.target
