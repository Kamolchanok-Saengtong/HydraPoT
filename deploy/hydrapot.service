# HydraPoT SSH honeypot — systemd unit.
#
# GENERATED by tools/install_service.py from the template alongside it.
# Paths below are baked in for one checkout, so re-run that script after
# moving or reinstalling the project rather than editing this by hand.
#
# Why supervision: without it a crashed sensor stays down until somebody
# notices, and a honeypot that is quiet because it died looks exactly
# like one that is quiet because nobody attacked it.

[Unit]
# StartLimit* live in [Unit], not [Service] — systemd 229 moved them and
# silently ignores them in the wrong section, which disables the restart
# rate limit without any error unless you read the journal.
StartLimitIntervalSec=300
StartLimitBurst=10
Description=HydraPoT multi-agent SSH honeypot
Documentation=https://github.com/Kamolchanok-Saengtong/HydraPoT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=creamy
Group=creamy
WorkingDirectory=/mnt/data-partition/honeypot
ExecStart=/mnt/data-partition/honeypot/honeypot_new/bin/hp run

# Always come back, including after a clean non-zero exit. RestartSec spaces
# retries so a config error does not spin the CPU restarting hundreds of times
# a second; StartLimit* stops an unfixable fault from restarting forever
# without ever surfacing as a failed unit.
Restart=always
RestartSec=5

# SIGTERM is what systemd sends on stop/restart. ssh_server.py's start_server()
# catches it via loop.add_signal_handler and stops the event loop gracefully,
# which lets main()'s finally block flush buffered SIEM events before exit.
# TimeoutStopSec gives that flush (and any in-flight writes) time to finish
# before systemd escalates to SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=30
KillMode=mixed

# The honeypot writes into the checkout (data/logs, data/threat_intel), so the
# filesystem cannot be fully read-only. These still remove privileges the
# process never needs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/mnt/data-partition/honeypot/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# Attackers scan port 22, not 2223. Binding it as an unprivileged user needs
# this one capability instead of running the whole process as root — which
# would be the exact privilege escalation attackers are trying to get.
# CapabilityBoundingSet caps it to only this, not root's full set.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# A honeypot invites hostile input. Caps stop a runaway session or a memory
# leak from taking the whole host down with it.
MemoryMax=4G
TasksMax=512

# Python buffers stdout when it is not a TTY, so under systemd every
# log line sat in a 8KB buffer instead of reaching the journal. On a
# quiet sensor that means you see nothing for hours, and anything not
# yet flushed is lost if the process is killed.
Environment=PYTHONUNBUFFERED=1

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hydrapot

[Install]
WantedBy=multi-user.target
